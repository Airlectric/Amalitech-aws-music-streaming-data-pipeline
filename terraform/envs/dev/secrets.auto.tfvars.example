# Secrets and account-specific values for dev environment
# Copy this file to secrets.auto.tfvars and fill in your values
# Terraform auto-loads *.auto.tfvars files - no need for -var-file

# No secrets currently required for the base infrastructure.
# As the project grows, add things like:
#   alerting_critical_emails = ["oncall@example.com"]
#   slack_webhook_url       = "https://hooks.slack.com/..."
