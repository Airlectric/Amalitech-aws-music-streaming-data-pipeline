# Music Streaming Data Pipeline - Dev Environment Variables
# Copy this file to terraform.tfvars and customize
# Non-sensitive configuration values

environment          = "dev"
aws_region           = "us-east-1"
bucket_suffix        = "YOUR_ACCOUNT_ID_HERE"

# SNS alert email subscriptions (add to secrets.auto.tfvars instead for sensitive values)
# sns_alert_emails = ["admin@example.com"]
